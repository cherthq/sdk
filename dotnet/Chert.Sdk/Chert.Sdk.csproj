<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.2.0-preview.1</Version>
    <PackageId>chert-sdk</PackageId>
    <AssemblyName>TryChert</AssemblyName>
    <RootNamespace>TryChert</RootNamespace>
    <Description>Chert iMessage and FaceTime clients with explicit independent credentials and single-attempt HTTP transports.</Description>
    <Authors>Chert</Authors>
    <PackageProjectUrl>https://trychert.com</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/cherthq/sdk</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../LICENSE" Pack="true" PackagePath="" />
    <None Include="../README.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
