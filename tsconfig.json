{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "bun"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "packages/**/*.ts",
    "scripts/test*.ts",
    "tests/client.test.ts",
    "tests/strict-core.test.ts",
    "tests/standalone*.ts"
  ]
}
