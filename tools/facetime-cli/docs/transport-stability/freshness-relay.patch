--- a/tests/poll-recovery.test.mjs
+++ b/tests/poll-recovery.test.mjs
@@ -0,0 +1,98 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { once } from 'node:events';
+import { createServer } from 'node:http';
+import { WebSocket } from 'ws';
+import { createRelay } from '../relay.mjs';
+
+const token=`ftc_${'a'.repeat(43)}`;
+async function rig(t, reply, connectDelay=0) {
+ let polls=0;const actions=[];const diagnostics=[];
+ const backend=createServer(async(req,res)=>{
+  let raw='';for await(const b of req)raw+=b;
+  const {action}=JSON.parse(raw);actions.push(action);
+  if(action==='connect'){if(connectDelay)await new Promise(r=>setTimeout(r,connectDelay));res.writeHead(200,{'content-type':'application/json'});res.end(JSON.stringify({data:{role:'standby',connection_generation:1}}));return;}
+  await reply({action,poll:action==='poll'?++polls:polls,res});
+ });
+ backend.listen(0,'127.0.0.1');await once(backend,'listening');
+ const relay=createRelay({controlOrigin:`http://127.0.0.1:${backend.address().port}`,secret:'test-secret-'.repeat(4),isolated:true,onDiagnostic:event=>diagnostics.push(event)});
+ relay.server.listen(0,'127.0.0.1');await once(relay.server,'listening');
+ const ws=new WebSocket(`ws://127.0.0.1:${relay.server.address().port}/connect`,{headers:{authorization:`Bearer ${token}`}});
+ ws.on('error',()=>{});
+ t.after(async()=>{ws.terminate();await relay.close();backend.closeAllConnections();await new Promise(r=>backend.close(r));});
+ return {ws,actions,diagnostics,get polls(){return polls;}};
+}
+const result=(res,data)=>{res.writeHead(200,{'content-type':'application/json'});res.end(JSON.stringify({data}));};
+const frame={type:'synthetic_delivery',message_id:'evidence'};
+
+test('a single stalled poll recovers without another connection or lost delivery', {timeout:6000},async t=>{
+ const r=await rig(t,async({poll,res})=>{
+  if(poll===1)return; // The request times out at the unchanged two-second bound.
+  result(res,{state:'standby',frames:[frame]});
+ });
+ const messages=[];
+ const delivered=new Promise((resolve,reject)=>{
+  r.ws.on('message',b=>{const v=JSON.parse(b);messages.push(v);if(v.type==='synthetic_delivery')resolve();});
+  r.ws.once('close',()=>reject(new Error('Transient poll failure closed the authenticated connection')));
+ });
+ await delivered;
+ assert.equal(messages.filter(x=>x.role==='standby').length,1);
+ assert.equal(r.actions.filter(x=>x==='connect').length,1);
+ assert.ok(r.polls>=2);
+ assert.ok(r.diagnostics.some(x=>x.code==='authority_timeout'&&x.action==='poll'));
+});
+
+for(const status of [401,403])test(`authorization ${status} closes immediately without retry`,async t=>{
+ const r=await rig(t,async({res})=>{res.writeHead(status);res.end('denied');});
+ const [code]=await once(r.ws,'close');assert.equal(code,1008);assert.equal(r.polls,1);
+});
+
+test('two unavailable polls close instead of retrying indefinitely',async t=>{
+ const r=await rig(t,async({res})=>{res.writeHead(503);res.end('unavailable');});
+ const [code]=await once(r.ws,'close');assert.equal(code,1008);assert.equal(r.polls,2);
+});
+
+test('invalid authority JSON closes without retry or raw-data diagnostics',async t=>{
+ const marker='SECRET_BODY_MUST_NOT_BE_LOGGED';
+ const r=await rig(t,async({res})=>{res.writeHead(200);res.end(marker);});
+ await once(r.ws,'close');assert.equal(r.polls,1);
+ assert.ok(!JSON.stringify(r.diagnostics).includes(marker));assert.ok(!JSON.stringify(r.diagnostics).includes(token));
+});
+
+test('a successful retry still honors the new binding role',async t=>{
+ const r=await rig(t,async({poll,res})=>{if(poll===1){res.writeHead(503);res.end();}else result(res,{state:'revoked',frames:[frame]});});
+ const delivered=[];r.ws.on('message',b=>delivered.push(JSON.parse(b)));
+ const [code]=await once(r.ws,'close');assert.equal(code,1012);assert.equal(r.polls,2);
+ assert.ok(!delivered.some(x=>x.type==='synthetic_delivery'));
+});
+
+test('decision failures are never replayed as poll retries',async t=>{
+ const r=await rig(t,async({action,res})=>{if(action==='decision'){res.writeHead(503);res.end();}else result(res,{state:'standby',frames:[]});});
+ await once(r.ws,'message');r.ws.send(JSON.stringify({type:'call.decision',connection_generation:1}));
+ await once(r.ws,'close');assert.equal(r.actions.filter(x=>x==='decision').length,1);
+});
+
+
+test('network reset on a poll is retried without changing generation',async t=>{
+ const r=await rig(t,async({poll,res})=>{if(poll===1){res.destroy();return;}result(res,{state:'standby',frames:[frame]});});
+ await new Promise((resolve,reject)=>{r.ws.on('message',b=>{if(JSON.parse(b).type==='synthetic_delivery')resolve();});r.ws.once('close',()=>reject(new Error('closed')));});
+ assert.equal(r.actions.filter(x=>x==='connect').length,1);
+ assert.ok(r.diagnostics.some(x=>x.code==='authority_network_error'));
+});
+
+test('retry is bounded by the last confirmed lease, not a fresh five seconds', {timeout:8000},async t=>{
+ const started=performance.now();
+ const r=await rig(t,async()=>{},1700);
+ const [code]=await once(r.ws,'close');
+ const elapsed=performance.now()-started;
+ assert.equal(code,1008);assert.equal(r.polls,2);
+ assert.ok(elapsed>=4900 && elapsed<5700,`lease close took ${elapsed} ms`);
+});
+
+test('authority heartbeat is absent during a stalled poll and emitted only after recovery', {timeout:6000},async t=>{
+ const r=await rig(t,async({poll,res})=>{if(poll===1)return;result(res,{state:'standby',frames:[]});});
+ const pings=[];r.ws.on('ping',b=>pings.push({value:b.toString(),at:performance.now()}));
+ await once(r.ws,'message');const start=performance.now();
+ await new Promise(resolve=>setTimeout(resolve,1700));assert.equal(pings.length,0);
+ await once(r.ws,'ping');assert.equal(pings[0].value,'chert-authority-v1');assert.ok(pings[0].at-start>=2000);
+});
