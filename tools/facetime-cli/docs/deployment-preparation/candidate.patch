+  try { const p=await principal(request); return privateNoStore(ok(request,await connectorData().manage(p.projectId,p.actorId,'list',{}))); }
+  catch(error) { return privateNoStore(fail(request,error)); }
+}
+export async function POST(request:Request) {
+  try { const p=await principal(request); const input=await body(request,connectorManagement,4096);
+    return privateNoStore(ok(request,await connectorData().manage(p.projectId,p.actorId,input.action,input))); }
+  catch(error) { return privateNoStore(fail(request,error)); }
