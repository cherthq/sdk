+    # Tests cancel only local monitor tasks. No production shutdown path is called.
+    for handle in owner.service.adapter._handles.values():
+        if handle.task:
+            handle.task.cancel()
+            await asyncio.gather(handle.task, return_exceptions=True)
+    owner.close_journals()
