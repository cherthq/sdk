+@pytest.mark.asyncio
+async def test_real_preparation_duplicate_lifecycle_cleanup_verification(tmp_path):
+    owner, provider = make_owner(tmp_path, synthetic_audio=True)
+    request = call()
+    try:
+        assert await owner.health() == 'unknown'
+        first, duplicate = await asyncio.gather(owner.prepare(request), owner.prepare(request))
+        assert first == duplicate and first['action'] == 'accept'
+        assert first['session_expires_at'] > time.time()*1000 + 590000
+        assert provider.load()['creates'] == provider.load()['dispatches'] == 1
+        assert provider.load()['reads'] >= 1
+        context = dict(session_ref=first['session_ref'], authoritative_terminal=True, acceptance='accept')
+        event = dict(event_id='end', transition='ended')
+        assert (await owner.lifecycle(request,event,context))['acknowledged']
+        assert (await owner.lifecycle(request,event,context))['acknowledged']
+        assert len(owner.operations.decisions['op']['events']) == 1
+        provider.control_path.write_text(json.dumps({'block_cleanup': True}))
+        assert (await owner.recover(request,context))['cleanup'] == 'pending'
+        assert owner.service.journal.receipts
+        provider.control_path.write_text('{}')
+        assert (await owner.recover(request,context))['cleanup'] == 'clean'
+        assert not provider.load()['rooms'] and not owner.service.journal.receipts
+    finally:
+        await dispose(owner)
