+"""Private application IPC, not an HTTP or Chert receiver. No implicit warming."""
+import asyncio
+import json
+import os
+from pathlib import Path
+import signal
+
+from owner import CallbackOwner
+from chert_reference_agent.avatar_adapter import AvatarAdapter
+from chert_reference_agent.config import Config
+
+
+async def serve(owner, path, stop):
+    path = Path(path)
+    if not path.is_absolute() or path.exists():
+        raise RuntimeError('fresh_socket_path_required')
+    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
+    if path.parent.stat().st_uid != os.getuid() or path.parent.stat().st_mode & 0o077:
+        raise RuntimeError('private_socket_directory_required')
+    tasks = set()
+    async def client(reader, writer):
+        try:
+            raw = await asyncio.wait_for(reader.readline(), 1)
+            if len(raw) > 32768:
+                raise ValueError('size')
+            request = json.loads(raw)
+            method = request['method']
+            if method not in ('health', 'prepare', 'lifecycle', 'recover'):
+                raise ValueError('method')
+            # Disconnect does not cancel the operation. A separate recover request
+            # records cancellation, including when preparation's response is lost.
+            task = asyncio.create_task(getattr(owner, method)(**request['args']))
+            tasks.add(task)
+            task.add_done_callback(tasks.discard)
+            result = await asyncio.shield(task)
+            response = {'ok': True, 'result': result}
+        except Exception:
+            response = {'ok': False}
+        try:
+            writer.write((json.dumps(response) + '\n').encode())
+            await writer.drain()
+        except (ConnectionError, BrokenPipeError):
+            pass
+        finally:
+            writer.close()
+            await writer.wait_closed()
+    server = await asyncio.start_unix_server(client, str(path), limit=32768)
+    os.chmod(path, 0o600)
+    try:
+        await stop.wait()
+    finally:
+        server.close()
+        await server.wait_closed()
+        path.unlink(missing_ok=True)
+        # No Service.shutdown / adapter.aclose: neither owns central decisions.
+        # In-flight effects on abrupt exit retain 'preparing' uncertainty.
+        owner.close_journals()
+
+
+async def main():
+    config = Config.from_env()
+    owner = CallbackOwner(config, AvatarAdapter(config), os.environ['TALKING_HEAD_OPERATION_JOURNAL'])
+    owner.open()
+    stop = asyncio.Event()
+    for sig in (signal.SIGINT, signal.SIGTERM):
+        asyncio.get_running_loop().add_signal_handler(sig, stop.set)
+    await serve(owner, os.environ['TALKING_HEAD_CALLBACK_SOCKET'], stop)
+
+
+if __name__ == '__main__':
+    asyncio.run(main())
