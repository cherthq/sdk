+"""Application-specific callback boundary; never imports or starts the HTTP app.
+
+Default capability matches the deployed audio+video profile, which cannot admit
+an audio-only connector call. Tests may inject a synthetic capability explicitly.
+Existing Service/AvatarAdapter remain the only room, dispatch and cleanup owners.
+"""
+import asyncio
+import hashlib
+import json
+import time
+import uuid
+
+from chert_reference_agent.avatar_service import AvatarService
+from chert_reference_agent.journal import Journal
+from chert_reference_agent.service import Resource
+
+
+class CallbackService(AvatarService):
+    def preparation_spec(self, resource):
+        return resource.callback_spec
+
+
+class CallbackOwner:
+    def __init__(self, config, adapter, operation_path, *, required_video=True):
+        self.service = CallbackService(config, adapter)
+        adapter.service = self.service
+        self.operations = Journal(operation_path, config.project_fingerprint + ':callback-v1')
+        self.required_video = required_video
+        self.tasks = {}
+        self.responses = {}
+        self.resources = {}
+        self.failed = False
+        self.opened = False
+
+    def open(self):
+        # Deliberately NOT Service.start(): that retires rooms on restart.
+        # No warm pool, lifespan, provider call, watcher, or cleanup here.
+        self.operations.open()
+        try:
+            self.service.journal.open()
+        except Exception:
+            self.operations.close()
+            raise
+        self.opened = True
+
+    def _save(self, operation, record):
+        try:
+            self.operations.save_decision(operation, record)
+        except Exception:
+            self.failed = True
+            raise RuntimeError('application_storage_unavailable') from None
+
+    def _record(self, call):
+        operation = call['operation_id']
+        digest = hashlib.sha256(json.dumps(call, sort_keys=True, separators=(',', ':')).encode()).hexdigest()
+        record = self.operations.decisions.get(operation)
+        if record is not None and record['digest'] != digest:
+            raise ValueError('operation_conflict')
+        return operation, digest, record
+
+    async def health(self):
+        # No ManualDemo.available/status/tick(): those can schedule cleanup.
+        if (not self.opened or self.failed or self.required_video or
+                self.service.config.run_mode != 'on_demand' or self.service.journal.receipts or
+                any(r['state'] not in ('clean', 'declined') for r in self.operations.decisions.values())):
+            return 'unavailable'
+        # Cold preparation is possible, not already media-ready.
+        return 'unknown'
+
+    async def prepare(self, call):
+        operation, digest, record = self._record(call)
+        if record:
+            if operation in self.tasks:
+                return await asyncio.shield(self.tasks[operation])
+            # Never regenerate credentials or repeat uncertain preparation after restart.
+            if record['state'] == 'prepared' and not record['cancel'] and call['prepare_deadline_at'] > time.time()*1000:
+                return self.responses.get(operation, {'action': 'decline'})
+            return {'action': 'decline'}
+        base = dict(digest=digest, state='declined', events={}, cancel=False)
+        if (self.failed or not self.opened or self.required_video or call['media'] != {'audio': True, 'video': False}
+                or self.service.config.run_mode != 'on_demand'
+                or call['prepare_deadline_at'] <= time.time() * 1000
+                or self.service.journal.receipts
+                or any(r['state'] not in ('declined', 'clean') for r in self.operations.decisions.values())):
+            self._save(operation, base)
+            return {'action': 'decline'}
+        # Use the existing session owner's room/spec conventions. Persist mapping
+        # before its _prepare writes the resource receipt and performs any effects.
+        room = self.service.config.namespace + '-' + uuid.uuid4().hex
+        resource = Resource(call['call_id'], room, call['prepare_deadline_at'] / 1000, time.monotonic())
+        spec = AvatarService.preparation_spec(self.service, resource)
+        expires = min(int(time.time() * 1000 + self.service.config.resource_ttl_seconds * 1000),
+                      call['maximum_session_expires_at'], spec['expires_at'] * 1000)
+        resource.callback_spec = spec
+        record = dict(base, state='preparing', room=room, spec=spec, expires_at=expires)
+        self._save(operation, record)
+        self.resources[operation] = resource
+        self.service.resources[('callback', operation)] = resource
+        task = asyncio.create_task(self._prepare(operation, resource))
+        self.tasks[operation] = task
+        return await asyncio.shield(task)
+
+    async def _prepare(self, operation, resource):
+        resource.task = asyncio.create_task(self.service._prepare(resource))
+        await asyncio.shield(resource.task)
+        record = self.operations.decisions[operation]
+        # A returned handle proves the awaited prepare completed. Cancellation or
+        # network failure without a handle does NOT establish provider settlement.
+        state = 'prepared' if resource.handle is not None else 'uncertain'
+        self._save(operation, dict(record, state=state))
+        result = {'action': 'decline'}
+        if resource.response.get('action') == 'accept' and not record['cancel']:
+            result = dict(resource.response, ready=True, session_ref=resource.room,
+                          session_expires_at=record['expires_at'])
+        self.responses[operation] = result
+        return result
+
+    async def lifecycle(self, call, event, context):
+        operation, digest, record = self._record(call)
+        if record is None:
+            # Terminal-before-prepare tombstone forbids later allocation.
+            if event['transition'] == 'started':
+                return {'acknowledged': False}
+            record = dict(digest=digest, state='declined', events={}, cancel=True)
+        previous = record['events'].get(event['event_id'])
+        if previous is not None and previous != event['transition']:
+            raise ValueError('event_conflict')
+        terminal = event['transition'] != 'started'
+        self._save(operation, dict(record, events={**record['events'], event['event_id']: event['transition']},
+                                  cancel=record['cancel'] or terminal))
+        # Durable application processing is distinct from verified cleanup.
+        # recover executes the saved cancellation and returns its evidence.
+        return {'acknowledged': True}
+
+    async def recover(self, call, context):
+        operation, digest, record = self._record(call)
+        if record is None:
+            # Socket request may never have reached the owner. Tombstone first so
+            # a delayed request cannot subsequently allocate under this operation.
+            self._save(operation, dict(digest=digest, state='declined', events={}, cancel=True))
+            return {'settled': True, 'cleanup': 'clean'}
+        room = record.get('room')
+        if context.get('session_ref') is not None and context['session_ref'] != room:
+            raise ValueError('session_ref_conflict')
+        result = dict(session_ref=room) if room else {}
+        if record['state'] in ('declined', 'clean'):
+            return dict(result, settled=True, cleanup='clean')
+        cancel = (record['cancel'] or context.get('cancel_requested') or context.get('authoritative_terminal')
+                  or context.get('acceptance') == 'decline' or record['expires_at'] <= time.time() * 1000)
+        if cancel and not record['cancel']:
+            record = dict(record, cancel=True)
+            self._save(operation, record)
+        task = self.tasks.get(operation)
+        resource = self.resources.get(operation)
+        if task is not None and not task.done():
+            if cancel and resource and resource.task:
+                resource.terminal = True
+                resource.task.cancel()
+            return dict(result, settled=False, cleanup='pending')
+        # Process death / cancelled SDK effect may complete remotely later. Keep
+        # the durable receipt; absence now is insufficient proof of settlement.
+        if record['state'] in ('preparing', 'uncertain'):
+            return dict(result, settled=False, cleanup='unknown')
+        if not cancel:
+            return dict(result, settled=True, cleanup='pending')
+        if resource is None:
+            resource = Resource(call['call_id'], room, 0, time.monotonic())
+            self.resources[operation] = resource
+        await asyncio.shield(self.service._schedule_cleanup(resource, 'callback_terminal'))
+        if resource.cleaned and room not in self.service.journal.receipts:
+            self._save(operation, dict(record, state='clean', cancel=True))
+            return dict(result, settled=True, cleanup='clean')
+        return dict(result, settled=True, cleanup='pending')
+
+    def close_journals(self):
+        # Process supervision must retain these journals; never run the receiver's
+        # shutdown here, which deletes accepted calls without central settlement.
+        self.service.journal.close()
+        self.operations.close()
+        self.opened = False
