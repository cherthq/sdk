+"""Isolated provider transports only. Real AvatarAdapter/Service code runs above."""
+import asyncio
+import json
+from pathlib import Path
+import time
+from types import SimpleNamespace as NS
+from unittest.mock import patch
+
+from chert_reference_agent.avatar_adapter import AvatarAdapter
+from chert_reference_agent.config import Config
+from owner import CallbackOwner
+
+
+class Provider:
+    def __init__(self, directory):
+        self.directory = Path(directory)
+        self.path = self.directory / 'provider.json'
+        self.control_path = self.directory / 'control.json'
+        if not self.path.exists():
+            self.save(dict(rooms={}, creates=0, dispatches=0, deletes=0, reads=0, late=0))
+        self.room = self
+        self.agent_dispatch = self
+
+    def load(self):
+        return json.loads(self.path.read_text())
+
+    def save(self, value):
+        self.path.write_text(json.dumps(value))
+
+    def control(self):
+        return json.loads(self.control_path.read_text()) if self.control_path.exists() else {}
+
+    async def create_room(self, request):
+        state = self.load()
+        state['creates'] += 1
+        state['rooms'][request.name] = {'spec': None}
+        self.save(state)
+
+    async def create_dispatch(self, request):
+        state = self.load()
+        state['dispatches'] += 1
+        state['rooms'][request.room]['spec'] = json.loads(request.metadata)
+        assert state['rooms'][request.room]['spec']['mode'] == 'chert-byor'
+        assert request.agent_name == 'demo-agent-0'
+        self.save(state)
+
+    async def list_participants(self, request):
+        late_completion = self.control().get('late_completion')
+        while self.control().get('hold'):
+            try:
+                await asyncio.sleep(.01)
+            except asyncio.CancelledError:
+                if not late_completion:
+                    raise
+                state = self.load()
+                state['late'] += 1
+                self.save(state)
+        state = self.load()
+        state['reads'] += 1
+        self.save(state)
+        spec = state['rooms'][request.room]['spec']
+        attrs = {'byor.ready': '1', 'byor.heartbeat': str(int(time.time()*1000)),
+                 'byor.audio': '10', 'byor.video': '10', 'byor.profile': 'classic'}
+        if self.control().get('unready'):
+            attrs['byor.ready'] = '0'
+        return NS(participants=[NS(identity=spec['agent_identity'], attributes=attrs,
+                                  tracks=[NS(type=0, muted=False), NS(type=1, muted=False)])])
+
+    async def delete_room(self, request):
+        state = self.load()
+        state['deletes'] += 1
+        if not self.control().get('block_cleanup'):
+            state['rooms'].pop(request.room, None)
+        self.save(state)
+
+    async def list_rooms(self, request):
+        state = self.load()
+        return NS(rooms=[NS(name=name, metadata='{}') for name in state['rooms']
+                         if not request.names or name in request.names])
+
+    async def aclose(self):
+        pass
+
+
+def make_owner(directory, *, synthetic_audio=False, run_mode='on_demand'):
+    directory = Path(directory)
+    provider = Provider(directory)
+    config = Config(webhook_routes={'/unused': {}}, signing_enabled=False,
+                    livekit_url='wss://isolated.invalid', livekit_api_key='synthetic-key',
+                    livekit_api_secret='synthetic-secret-for-local-qualification-only',
+                    namespace='demo-byor', journal_path=str(directory/'resources.json'),
+                    agent_run_mode=run_mode, token_ttl_seconds=900, resource_ttl_seconds=600,
+                    cleanup_attempts=1, cleanup_timeout_seconds=.1)
+    with patch('chert_reference_agent.livekit_adapter.api.LiveKitAPI', return_value=provider):
+        adapter = AvatarAdapter(config)
+    owner = CallbackOwner(config, adapter, directory/'operations.json', required_video=not synthetic_audio)
+    owner.open()
+    return owner, provider
