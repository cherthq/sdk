+import asyncio
+import json
+from pathlib import Path
+import sys
+import time
+
+import pytest
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from substitutes import make_owner
+
+
+def call(operation='op', budget=4000):
+    now = int(time.time()*1000)
+    return dict(operation_id=operation, project_id='project', line_id='line', call_id='call',
+                request_id='request', deadline_at=now+5000, prepare_deadline_at=now+budget,
+                maximum_session_expires_at=now+7200000, media={'audio': True, 'video': False})
+
+
