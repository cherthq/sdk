+@pytest.mark.asyncio
+async def test_late_completion_stays_unsettled_until_original_prepare_finishes(tmp_path):
+    owner, provider = make_owner(tmp_path, synthetic_audio=True)
+    provider.control_path.write_text(json.dumps({'hold': True, 'late_completion': True}))
+    request = call(budget=30)
+    task = asyncio.create_task(owner.prepare(request))
+    try:
+        await asyncio.sleep(.08)
+        assert not task.done()
+        status = await owner.recover(request,dict(cancel_requested=True))
+        assert status['settled'] is False and status['cleanup'] == 'pending'
+        provider.control_path.write_text('{}')
+        assert (await task)['action'] == 'decline'
+        for _ in range(30):
+            status = await owner.recover(request,dict(cancel_requested=True))
+            if status['cleanup'] == 'clean':
+                break
+            await asyncio.sleep(.01)
+        assert status['settled'] and status['cleanup'] == 'clean'
+        assert provider.load()['creates'] == provider.load()['dispatches'] == 1
+    finally:
+        provider.control_path.write_text('{}')
+        await asyncio.gather(task, return_exceptions=True)
+        await dispose(owner)
+
