+import { createServer } from 'node:http';
+import { createServer as createSecureServer } from 'node:https';
+import { WebSocketServer, WebSocket } from 'ws';
+const MAX = 32768;
+class AuthorityError extends Error { constructor(status) { super('authority_rejected'); this.status=status; } }
+export function serviceOrigin(value, isolated = false) {
+  const u = new URL(value);
+  if (u.username || u.password || u.search || u.hash || u.pathname !== '/' ||
+    !(u.protocol === 'https:' || (isolated && u.protocol === 'http:' && u.hostname === '127.0.0.1' && u.port))) throw new Error('invalid_origin');
+  return u;
+}
+async function json(stream) {
+  let length=0; const chunks=[];
+  for await (const chunk of stream) { length+=chunk.length; if(length>MAX) throw new Error('too_large'); chunks.push(chunk); }
+  return JSON.parse(Buffer.concat(chunks).toString());
+}
+export function createRelay({controlOrigin,secret,isolated=false,tls}) {
+  const endpoint=new URL('/api/internal/v1/connectors',serviceOrigin(controlOrigin,isolated));
+  if(!secret || secret.length<32) throw new Error('missing_relay_secret');
+  const wss=new WebSocketServer({noServer:true,maxPayload:MAX,perMessageDeflate:false});
+  const sockets=new Set();
+  async function authority(credential,action,input={}) {
+    const response=await fetch(endpoint,{method:'POST',redirect:'error',signal:AbortSignal.timeout(2000),headers:{authorization:`Bearer ${secret}`,'content-type':'application/json'},body:JSON.stringify({credential,action,input})});
+    if(!response.ok) { await response.body?.cancel(); throw new AuthorityError(response.status); }
+    const result=await json(response.body);
+    return result.data;
+  }
+  function credential(request) {
+    const match=/^Bearer (ftc_[A-Za-z0-9_-]{43})$/.exec(request.headers.authorization ?? '');
+    if(!match) throw new AuthorityError(403);
+    return match[1];
+  }
+  const handler=async(req,res)=>{
+    try {
+      if(req.method==='GET' && req.url==='/healthz') { res.writeHead(200); res.end('ok'); return; }
+      if(req.method!=='POST' || !['/reconcile','/inspect'].includes(req.url)) { res.writeHead(404); res.end(); return; }
+      const result=await authority(credential(req),req.url.slice(1),await json(req));
+      res.writeHead(200,{'content-type':'application/json','cache-control':'no-store'});res.end(JSON.stringify(result));
+    } catch(error) { res.writeHead(error instanceof AuthorityError && [401,403].includes(error.status) ? 403 : 503,{'content-type':'application/json','cache-control':'no-store'});res.end('{"status":"unknown"}'); }
+  };
+  const server=tls ? createSecureServer(tls,handler) : createServer(handler);
+  server.headersTimeout=5000; server.requestTimeout=5000;
+  server.on('upgrade',(req,socket,head)=>{
+    void(async()=>{
+      if(req.url!=='/connect' || req.headers.origin) throw new Error('forbidden');
+      const token=credential(req);
+      const welcome=await authority(token,'connect');
+      if(socket.destroyed) return;
+      wss.handleUpgrade(req,socket,head,ws=>{
+        sockets.add(ws); ws.send(JSON.stringify(welcome));
+        let stopped=false,timer,inflight=0;
+        const seen=new Map();
+        const fail=()=>ws.close(1008,'authority_unavailable');
+        const poll=async()=>{
+          if(stopped) return;
+          try {
+            const result=await authority(token,'poll',{connection_generation:welcome.connection_generation});
+            const role=result.state==='revoked' || result.state==='draining' ? 'draining' : result.state;
+            if(welcome.role!=='draining' && role!==welcome.role) { ws.close(1012,'binding_changed'); return; }
+            for(const frame of result.frames) {
+              const key=frame.message_id;
+              // Retry durable delivery once per second until acknowledgement. Never cache decisions or credentials.
+              if(Date.now()-(seen.get(key) ?? 0)>=1000) { if(ws.bufferedAmount>MAX*4) throw new Error('slow_consumer'); if(ws.readyState===WebSocket.OPEN) ws.send(JSON.stringify(frame)); seen.set(key,Date.now()); }
+            }
+            if(seen.size>1024) seen.clear();
+          } catch { fail(); }
+          if(!stopped) timer=setTimeout(poll,200);
+        };
+        ws.on('message',(bytes,binary)=>{
+          if(stopped || inflight>=8) { fail(); return; }
+          inflight++;
+          void(async()=>{
+            if(binary) throw new Error('invalid_frame');
+            const frame=JSON.parse(bytes.toString());
+            if(frame.type==='call.decision') {
+              if(frame.connection_generation!==welcome.connection_generation) throw new Error('stale_generation');
+              const receipt=await authority(token,'decision',frame);
+              if(ws.readyState===WebSocket.OPEN) ws.send(JSON.stringify(receipt));
+            } else if(frame.type==='lifecycle.ack') {
+              await authority(token,'ack',{...frame,transport_generation:welcome.connection_generation});
+            } else throw new Error('invalid_frame');
+          })().catch(fail).finally(()=>{inflight--;});
+        });
+        ws.on('error',()=>{});
+        ws.on('close',()=>{stopped=true;clearTimeout(timer);sockets.delete(ws);});
+        void poll();
+      });
+    })().catch(()=>{socket.end('HTTP/1.1 403 Forbidden\r\nConnection: close\r\n\r\n');});
+  });
+  return {server,async close(){for(const ws of sockets) ws.terminate(); await new Promise(resolve=>server.close(resolve)); await new Promise(resolve=>wss.close(resolve));}};
+}
