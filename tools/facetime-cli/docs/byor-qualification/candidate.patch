+async function principal(request:Request) {
+  const auth=await authenticateProjectRequest(request,'facetime:write');
+  if(auth.kind!=='user' || !auth.actorId || !['owner','admin'].includes(auth.role ?? ''))
+    throw new ControlPlaneError('forbidden','Owner or admin user session required',403);
+  return {projectId:auth.projectId,actorId:auth.actorId};
