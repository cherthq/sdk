+import { createHash, randomBytes, randomUUID, timingSafeEqual } from 'node:crypto';
+import { z } from 'zod';
+import { ControlPlaneError } from './errors';
+import { validateByorCredentials } from './byor-credentials';
+import { sealByorCredentials } from './credential-seal';
+
+const id = z.string().uuid();
+const integer = z.number().int().nonnegative().max(Number.MAX_SAFE_INTEGER);
+export const connectorOwner = z.object({project_id:id,line_id:id,binding_id:id,binding_epoch:integer,
+  instance_id:id,connection_generation:integer,call_id:id,request_id:id,session_mode:z.enum(['byor','create-room']).optional()}).strict();
+const header = {v:z.literal(1),message_id:id,type:z.literal('call.decision')};
+const decision = z.discriminatedUnion('action',[
+  connectorOwner.extend({...header,action:z.literal('accept'),livekit_url:z.string().max(2048),participant_token:z.string().max(16384),remote_participant_identity:z.string().min(1).max(240),session_expires_at:integer.optional()}),
+  connectorOwner.extend({...header,action:z.literal('decline'),reason:z.string().min(1).max(100)}),
+]);
+export const connectorManagement = z.discriminatedUnion('action',[
+  z.object({action:z.literal('enroll'),line_id:id,name:z.string().min(1).max(100),environment:z.enum(['production','development']),session_mode:z.enum(['byor','create-room']).optional()}).strict(),
+  z.object({action:z.literal('activate'),binding_id:id,expected_binding_id:id.nullable(),assignment_generation:integer}).strict(),
+  z.object({action:z.enum(['drain','revoke']),binding_id:id}).strict(),
+]);
+export const connectorRuntime = z.object({credential:z.string().regex(/^ftc_[A-Za-z0-9_-]{43}$/),
+  action:z.enum(['connect','poll','inspect','decision','ack','reconcile']),input:z.record(z.unknown())}).strict();
+export type ConnectorRPC = (name:string,args:Record<string,unknown>) => Promise<unknown>;
+export class ConnectorBackend {
+  constructor(private readonly rpc:ConnectorRPC,private readonly hash:(value:string)=>string) {}
+  async manage(projectId:string, actorId:string, action:string, input:Record<string,unknown>) {
+    const tokens = action==='enroll' ? {connection:`ftc_${randomBytes(32).toString('base64url')}`,recovery:`ftc_${randomBytes(32).toString('base64url')}`} : undefined;
+    const data = await this.rpc('facetime_connector_manage',{p_project_id:projectId,p_actor_id:actorId,p_action:action,
+      p_input:tokens ? {...input,connection_hash:this.hash(tokens.connection),recovery_hash:this.hash(tokens.recovery)} : input});
+    return tokens ? {...data as Record<string,unknown>,credentials:tokens} : data;
+  }
+  async runtime(raw:unknown) {
+    const request=connectorRuntime.parse(raw);
+    const invoke=(action:string,input:Record<string,unknown>)=>this.rpc('facetime_connector_runtime',{p_hash:this.hash(request.credential),p_action:action,p_input:input});
+    if(request.action==='decision') {
+      const frame=decision.parse(request.input);
+      const owner=connectorOwner.parse(Object.fromEntries(Object.keys(connectorOwner.shape).map(k=>[k,frame[k as keyof typeof frame]])));
+      // Stable semantic content: transport message IDs/generation do not alter a decision.
+      const content=frame.action==='accept' ? [frame.action,frame.livekit_url,frame.participant_token,frame.remote_participant_identity,...(frame.session_expires_at === undefined ? [] : [frame.session_expires_at])] : [frame.action,frame.reason];
+      const input:Record<string,unknown>={owner,connection_generation:frame.connection_generation,action:frame.action,digest:createHash('sha256').update(JSON.stringify(content)).digest('hex')};
+      const replay=await invoke('decision_replay',input);
+      if(replay) return replay;
+      if(frame.action==='accept') {
+        const target=await invoke('target',input) as {worker_id:string;resource_expires_at:number;session_mode?:string};
+        const credentials=validateByorCredentials({livekitUrl:frame.livekit_url,participantToken:frame.participant_token,expectedParticipantIdentity:frame.remote_participant_identity});
+        const byor=target.session_mode==='byor';
+        const requested=frame.session_expires_at;
+        if ((byor && (requested === undefined || requested<=Date.now() || requested>credentials.leaseExpiresAt.getTime() || requested>target.resource_expires_at)) || (!byor && requested!==undefined))
+          throw new ControlPlaneError('connector_session_expiry_invalid','Explicit BYOR session expiry must fit the call and credential limits',422);
+        const session=randomUUID();
+        const sealed=sealByorCredentials({projectId:owner.project_id,workerId:target.worker_id,sessionId:session,livekitUrl:credentials.livekitUrl,participantToken:credentials.participantToken});
+        Object.assign(input,{session_id:session,room:credentials.roomReference,identity:credentials.expectedParticipantIdentity,
+          token_expires_at:credentials.tokenExpiresAt.toISOString(),lease_expires_at:new Date(byor ? requested! : Math.min(credentials.leaseExpiresAt.getTime(),target.resource_expires_at)).toISOString(),
+          url_ciphertext:sealed.livekitUrlCiphertext,token_ciphertext:sealed.participantTokenCiphertext,fingerprint:sealed.tokenFingerprint,key_version:sealed.keyVersion});
+      }
+      return invoke('decision',input);
+    }
+    if(request.action==='reconcile') return invoke('reconcile',{owner:connectorOwner.parse(request.input)});
+    if(request.action==='ack') {
+      const ack=connectorOwner.extend({v:z.literal(1),type:z.literal('lifecycle.ack'),message_id:id,event_id:id,cursor:integer,transport_generation:integer}).parse(request.input);
+      const owner=connectorOwner.parse(Object.fromEntries(Object.keys(connectorOwner.shape).map(k=>[k,ack[k as keyof typeof ack]])));
+      // Delivery ownership retains its original generation; the envelope carries the live connection fence.
+      return invoke('ack',{owner,event_id:ack.event_id,cursor:ack.cursor,connection_generation:request.input.transport_generation});
+    }
+    const input=request.action==='poll' ? z.object({connection_generation:integer}).strict().parse(request.input) : z.object({}).strict().parse(request.input);
+    return invoke(request.action,input);
+  }
+}
+export function requireRelay(request:Request, secret:string|undefined) {
+  const presented=request.headers.get('authorization');
+  if(!secret || secret.length<32 || !presented || !timingSafeEqual(createHash('sha256').update(presented).digest(),createHash('sha256').update(`Bearer ${secret}`).digest()))
+    throw new ControlPlaneError('unauthorized','Relay authentication failed',401);
+}
