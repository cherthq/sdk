+import assert from 'node:assert/strict';
+import { once } from 'node:events';
+import { createRelay, serviceOrigin } from '../relay.mjs';
+test('deployment requires encrypted origins and isolated mode only permits literal loopback',()=>{
+ assert.equal(serviceOrigin('https://control.example').protocol,'https:');
+ for(const value of ['http://control.example','http://127.0.0.1:3333','https://user:secret@example.com','https://example.com/path','https://example.com/?token=secret']) assert.throws(()=>serviceOrigin(value));
+ assert.equal(serviceOrigin('http://127.0.0.1:3333',true).hostname,'127.0.0.1');
+ assert.throws(()=>serviceOrigin('http://localhost:3333',true));
+ assert.throws(()=>createRelay({controlOrigin:'https://control.example',secret:'short'}));
+});
+test('malformed credentials never reach the control-plane network',async()=>{
+ const relay=createRelay({controlOrigin:'https://must-not-contact.invalid',secret:'isolated-long-secret-'.repeat(3)});
+ relay.server.listen(0,'127.0.0.1');await once(relay.server,'listening');
+ try {
+  const response=await fetch(`http://127.0.0.1:${relay.server.address().port}/reconcile`,{method:'POST',body:'{}',headers:{authorization:'Bearer foreign'}});
+  assert.equal(response.status,403);assert.deepEqual(await response.json(),{status:'unknown'});
+ } finally {await relay.close();}
+});
+
+test('an unavailable authority is distinct from rejected authorization',async()=>{
+ const relay=createRelay({controlOrigin:'http://127.0.0.1:1',secret:'isolated-long-secret-'.repeat(3),isolated:true});
+ relay.server.listen(0,'127.0.0.1');await once(relay.server,'listening');
+ try {
+  const response=await fetch(`http://127.0.0.1:${relay.server.address().port}/inspect`,{method:'POST',body:'{}',headers:{authorization:`Bearer ftc_${'a'.repeat(43)}`}});
+  assert.equal(response.status,503);assert.deepEqual(await response.json(),{status:'unknown'});
+ } finally {await relay.close();}
+});
