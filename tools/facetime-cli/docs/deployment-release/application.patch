+"""Durable application-owned ready sessions. Admission never prepares a provider.
+
+Staging is an explicit application/operator operation, separate from the Chert
+callback. One owner process holds both journal locks for its entire lifetime.
+"""
+import asyncio
+import hashlib
+import json
+import os
+from pathlib import Path
+import stat
+import re
+import time
+import uuid
+
+from chert_reference_agent.avatar_adapter import AvatarHandle
+from chert_reference_agent.avatar_service import AvatarService
+from chert_reference_agent.journal import Journal
+from chert_reference_agent.manual import PREPARE_SECONDS
+from chert_reference_agent.service import Resource
+from owner import CallbackService
+
+
+class ReadySessionOwner:
+    required_video = True
+
+    def __init__(self, config, adapter, operation_path):
+        self.service = CallbackService(config, adapter)
+        adapter.service = self.service
+        # Deliberately incompatible with the old cold-prepare journal.
+        self.operations = Journal(operation_path, config.project_fingerprint + ':ready-owner-v1')
+        self.opened = False
+        self.failed = False
+        self.tasks = {}
+        self.resources = {}
+        self.responses = {}
+        self.tick_lock = asyncio.Lock()
+        self.expiries = {}
+        adapter.bind_owner(self._lookup_room, self._created)
+
+    def open(self):
+        for path in (self.operations.path, self.service.journal.path):
+            if not path.is_absolute():
+                raise RuntimeError('absolute_state_path_required')
+            parent = Path(path).parent
+            parent.mkdir(parents=True, exist_ok=True, mode=0o700)
+            info = parent.lstat()
+            if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
+                raise RuntimeError('private_state_directory_required')
+        self.operations.open()
+        try:
+            self.service.journal.open()
+            for key, record in self.operations.decisions.items():
+                if record['kind'] == 'slot':
+                    if key != 'slot:' + record['slot_id'] or not re.fullmatch(
+                            re.escape(self.service.config.namespace) + r'-[0-9a-f]{32}', record['room']):
+                        raise ValueError('invalid_slot')
+                    self._deadline(key, record['expires_at'])
+                elif record['kind'] != 'claim' or key != 'call:' + record['call']['operation_id']:
+                    raise ValueError('invalid_claim')
+        except Exception:
+            self.service.journal.close()
+            self.operations.close()
+            raise
+        self.opened = True
