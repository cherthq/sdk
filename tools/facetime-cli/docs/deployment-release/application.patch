+"""Actual local processes/sockets/storage; provider transports alone substituted."""
+import asyncio
+import json
+import os
+from pathlib import Path
+import signal
+import sys
+from tempfile import TemporaryDirectory
+
+import pytest
+from test_owner import call
+
+
+@pytest.fixture
+def tmp_path():
+    with TemporaryDirectory(prefix='th-host-', dir='/tmp') as directory:
+        yield Path(directory)
+
+
+async def rpc(path, method, **args):
+    reader, writer = await asyncio.open_unix_connection(str(path))
+    writer.write((json.dumps(dict(method=method, args=args))+'\n').encode())
+    await writer.drain()
+    result = json.loads(await asyncio.wait_for(reader.readline(), 3))
+    writer.close()
+    await writer.wait_closed()
+    return result
+
+
+async def start(directory, *options):
+    root = Path(__file__).resolve().parents[2]
+    process = await asyncio.create_subprocess_exec(sys.executable, str(root/'connector/tests/fixture_server.py'),
+        str(directory), '--ready-owner', *options, env={**os.environ, 'PYTHONPATH': str(root/'receiver/src')},
+        stdout=asyncio.subprocess.DEVNULL, stderr=asyncio.subprocess.PIPE)
+    for _ in range(100):
+        if process.returncode is not None:
+            raise RuntimeError((await process.stderr.read()).decode())
+        try:
+            if (await rpc(directory/'owner.sock', 'health'))['ok']:
+                return process
+        except (FileNotFoundError, ConnectionRefusedError):
+            pass
+        await asyncio.sleep(.02)
+    process.kill()
+    await process.wait()
+    raise AssertionError('owner_start_timeout')
+
+
+async def stop(process, sig=signal.SIGTERM):
+    if process.returncode is None:
+        process.send_signal(sig)
+    await asyncio.wait_for(process.wait(), 5)
+
+
+@pytest.mark.asyncio
+async def test_sigkill_reopen_retains_claim_and_expires_independently(tmp_path):
+    os.chmod(tmp_path, 0o700)
+    process = await start(tmp_path)
+    request = dict(call(), media={'audio': True, 'video': True})
+    try:
+        assert (await rpc(tmp_path/'admin.sock','stage',slot_id='slot'))['result']['state'] == 'ready'
+        assert (await rpc(tmp_path/'owner.sock','stage',slot_id='wrong'))['ok'] is False
+        accepted = (await rpc(tmp_path/'owner.sock','prepare',call=request))['result']
+        assert accepted['action'] == 'accept'
+        await stop(process, signal.SIGKILL)
+        # Reopen proves stale socket recovery; no resource deletion at restart.
+        process = await start(tmp_path)
+        state = (await rpc(tmp_path/'owner.sock','recover',call=request,context={}))['result']
+        assert state['session_ref'] == accepted['session_ref'] and state['cleanup'] == 'pending'
+        def provider():
+            return json.loads((tmp_path/'provider.json').read_text())
+        assert provider()['creates'] == 1 and provider()['deletes'] == 0
+        assert (await rpc(tmp_path/'owner.sock','prepare',call=request))['result']['action'] == 'decline'
+        # Persisted terminal is enough; no connector recover/cleanup call follows.
+        await rpc(tmp_path/'owner.sock','lifecycle',call=request,event={'event_id':'end','transition':'ended'},context={})
+        for _ in range(100):
+            if not provider()['rooms']:
+                break
+            await asyncio.sleep(.02)
+        assert not provider()['rooms']
+        assert provider()['creates'] == 1
+    finally:
+        await stop(process)
+
+
+@pytest.mark.asyncio
+async def test_owner_watch_expires_short_test_lease_without_any_callback(tmp_path):
