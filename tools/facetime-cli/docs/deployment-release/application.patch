+"""Existing avatar readiness/token/cleanup with a durable exact-room fence."""
+import asyncio
+import json
+
+from livekit import api
+from chert_reference_agent.avatar_adapter import AvatarAdapter, AvatarHandle, EMPTY_ROOM_TIMEOUT_SECONDS
+
+
+class ReadyAvatarAdapter(AvatarAdapter):
+    def bind_owner(self, lookup, record_created):
+        self.lookup = lookup
+        self.record_created = record_created
+
+    async def prepare(self, spec):
+        handle = AvatarHandle(spec)
+        self._handles[spec['room']] = handle
+        room = await self._api.room.create_room(api.CreateRoomRequest(
+            name=spec['room'], empty_timeout=EMPTY_ROOM_TIMEOUT_SECONDS, max_participants=3,
+            metadata=json.dumps({'callback_owner': spec['ownership_marker']})))
+        if not room.sid:
+            raise RuntimeError('room_sid_missing')
+        # Persist the creation acknowledgment before dispatch. A crash before this
+        # write leaves staging uncertain, not proof that creation never happened.
+        self.record_created(spec['room'], room.sid)
+        await self._api.agent_dispatch.create_dispatch(api.CreateAgentDispatchRequest(
+            room=spec['room'], agent_name='demo-agent-0', metadata=json.dumps({**spec, 'mode': 'chert-byor'})))
+        while not await self._refresh(handle):
+            await asyncio.sleep(.2)
+        handle.task = asyncio.create_task(self._monitor(handle))
+        return handle
+
+    async def verify_room(self, room):
+        slot = self.lookup(room)
+        result = await self._api.room.list_rooms(api.ListRoomsRequest(names=[room]))
+        matches = [r for r in result.rooms if r.name == room]
+        if not matches:
+            return False
+        if len(matches) != 1 or not slot.get('room_sid') or matches[0].sid != slot['room_sid']:
+            raise RuntimeError('room_owner_mismatch')
+        try:
+            marker = json.loads(matches[0].metadata).get('callback_owner')
+        except (ValueError, AttributeError):
+            marker = None
+        if marker != slot['spec']['ownership_marker']:
+            raise RuntimeError('room_owner_mismatch')
+        return True
+
+    async def close_room(self, room):
+        await self.verify_room(room)  # absent is allowed only for settled slots
+        await super().close_room(room)
