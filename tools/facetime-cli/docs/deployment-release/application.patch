+"""Private application IPC. Starts maintenance, never staging or an agent."""
+import argparse
+import asyncio
+import fcntl
+import json
+import os
+from pathlib import Path
+import signal
+import stat
+
+from ready_owner import ReadySessionOwner
+from ready_adapter import ReadyAvatarAdapter
+from chert_reference_agent.config import Config
+
+
+class SocketLease:
+    """Kernel lock proves exclusive socket ownership, including after SIGKILL."""
+    def __init__(self, path):
+        self.path = Path(path)
+        self.fd = None
+        self.inode = None
+
+    def acquire(self):
+        path = self.path
+        if not path.is_absolute():
+            raise RuntimeError('absolute_socket_path_required')
+        path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
+        info = path.parent.lstat()
+        if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
+            raise RuntimeError('private_socket_directory_required')
+        self.fd = os.open(str(path)+'.lock', os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
+        try:
+            info = os.fstat(self.fd)
+            if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
+                raise RuntimeError('private_socket_lock_required')
+            fcntl.flock(self.fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
+            if path.exists() or path.is_symlink():
+                info = path.lstat()
+                if not stat.S_ISSOCK(info.st_mode) or info.st_uid != os.getuid():
+                    raise RuntimeError('foreign_socket_path')
+                # Prior process must have held this same lease; journal locks
+                # additionally exclude an old owner using another socket path.
+                path.unlink()
+        except Exception:
+            self.close()
+            raise
+
+    def bound(self):
+        self.inode = self.path.lstat().st_ino
+
+    def close(self):
+        if self.inode is not None:
+            try:
+                if self.path.lstat().st_ino == self.inode:
+                    self.path.unlink()
+            except FileNotFoundError:
+                pass
+        if self.fd is not None:
+            os.close(self.fd)
+            self.fd = None
+
+
+async def serve(owner, path, stop, admin_path=None):
+    tasks = set()
+    servers = []
+    leases = []
+    watcher = None
+    async def client(reader, writer, allowed):
+        try:
+            raw = await asyncio.wait_for(reader.readline(), 1)
+            if len(raw) > 32768:
+                raise ValueError('size')
+            request = json.loads(raw)
+            if request['method'] not in allowed:
+                raise ValueError('method')
+            # Socket disconnection cannot cancel a durable operation.
+            task = asyncio.create_task(getattr(owner, request['method'])(**request['args']))
+            tasks.add(task)
+            task.add_done_callback(tasks.discard)
+            result = await asyncio.shield(task)
+            response = {'ok': True, 'result': result}
+        except Exception:
+            response = {'ok': False}
+        try:
+            writer.write((json.dumps(response) + '\n').encode())
+            await writer.drain()
+        except (ConnectionError, BrokenPipeError):
+            pass
+        finally:
+            writer.close()
+            try:
+                await writer.wait_closed()
+            except ConnectionError:
+                pass
+    endpoints = [(path, ('health', 'prepare', 'lifecycle', 'recover'))]
+    if admin_path:
+        endpoints.append((admin_path, ('stage', 'cancel_slot', 'status')))
+    try:
+        for endpoint, allowed in endpoints:
+            lease = SocketLease(endpoint)
+            lease.acquire()
+            leases.append(lease)
+            server = await asyncio.start_unix_server(
+                lambda r, w, allowed=allowed: client(r, w, allowed), str(endpoint), limit=32768)
+            servers.append(server)
+            os.chmod(endpoint, 0o600)
+            lease.bound()
+        if isinstance(owner, ReadySessionOwner):
+            watcher = asyncio.create_task(owner.watch(stop))
+        await stop.wait()
+    finally:
+        for server in servers:
+            server.close()
+            await server.wait_closed()
+        if watcher:
+            await watcher
+        # Keep writer locks until effects and cleanup stop. A supervisor may
+        # SIGKILL a hung shutdown; preparing then reopens as uncertainty.
+        if tasks:
+            await asyncio.gather(*tasks, return_exceptions=True)
+        if hasattr(owner, 'tasks'):
+            await asyncio.gather(*owner.tasks.values(), return_exceptions=True)
+        for handle in owner.service.adapter._handles.values():
+            if handle.task:
+                handle.task.cancel()
+                await asyncio.gather(handle.task, return_exceptions=True)
+        owner.close_journals()
+        for lease in leases:
+            lease.close()
+        await owner.service.adapter._api.aclose()
+
+
+async def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--initialize-state', action='store_true')
+    args = parser.parse_args()
+    os.umask(0o077)
+    config = Config.from_env()
+    owner = ReadySessionOwner(config, ReadyAvatarAdapter(config), os.environ['TALKING_HEAD_OPERATION_JOURNAL'])
+    paths = [owner.operations.path, owner.service.journal.path]
+    if args.initialize_state:
+        if any(p.exists() for p in paths):
+            raise RuntimeError('initialization_requires_fresh_state')
+    elif not all(p.is_file() for p in paths):
+        raise RuntimeError('persistent_state_missing')
+    owner.open()
+    if args.initialize_state:
+        owner.close_journals()
+        await owner.service.adapter._api.aclose()
+        return
+    stop = asyncio.Event()
+    for sig in (signal.SIGINT, signal.SIGTERM):
+        asyncio.get_running_loop().add_signal_handler(sig, stop.set)
+    await serve(owner, os.environ['TALKING_HEAD_CALLBACK_SOCKET'], stop,
+                os.environ['TALKING_HEAD_ADMIN_SOCKET'])
+
+
+if __name__ == '__main__':
+    asyncio.run(main())
