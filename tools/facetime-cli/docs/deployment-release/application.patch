+@pytest.mark.asyncio
+async def test_recovery_tombstone_and_storage_failure_prevent_claim(tmp_path):
+    owner, provider = ready_owner(tmp_path)
+    request = dict(call(), media={'audio': True, 'video': True})
+    try:
+        assert (await owner.recover(request, {}))['cleanup'] == 'clean'
+        await owner.stage('slot-1')
+        assert (await owner.prepare(request))['action'] == 'decline'
+        def broken():
+            raise OSError('fsync')
+        owner.operations._save = broken
+        with pytest.raises(RuntimeError, match='storage'):
+            await owner.prepare(dict(request, operation_id='other'))
+        assert await owner.health() == 'unavailable'
+        assert not owner.responses
+        assert provider.load()['creates'] == 1
+    finally:
+        await dispose(owner)
