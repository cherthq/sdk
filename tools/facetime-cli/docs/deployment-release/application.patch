+"""Never load environment credentials; only synthetic provider transports."""
+import asyncio
+import json
+import os
+from pathlib import Path
+import signal
+import socket
+import sys
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from server import serve
+from substitutes import make_owner, make_ready_owner
+
+# Any accidental Internet/provider connection fails before leaving this process.
+original_connect = socket.socket.connect
+def local_only(self, address):
+    if self.family in (socket.AF_INET, socket.AF_INET6):
+        raise RuntimeError('network_forbidden_in_qualification')
+    return original_connect(self, address)
+socket.socket.connect = local_only
+
+async def main():
+    directory = Path(sys.argv[1])
+    owner, _ = make_owner(directory, synthetic_audio='--synthetic-audio-policy' in sys.argv,
+                          run_mode='continuous' if '--continuous' in sys.argv else 'on_demand')
+    if '--ready-owner' in sys.argv:
+        owner.close_journals()
+        owner, _ = make_ready_owner(directory, short_ttl='--short-ttl' in sys.argv)
+    assert 'chert_reference_agent.http' not in sys.modules
+    assert owner.service._watcher is None and owner.service.manual.watcher is None
+    (directory/'startup.json').write_text(json.dumps({'http_imported': False, 'watchers_started': False,
+        'required_video': owner.required_video, 'run_mode': owner.service.config.run_mode}))
+    stop = asyncio.Event()
+    for sig in (signal.SIGTERM, signal.SIGINT):
+        asyncio.get_running_loop().add_signal_handler(sig, stop.set)
+    await serve(owner, directory/'owner.sock', stop, directory/'admin.sock' if '--ready-owner' in sys.argv else None)
+
+if __name__ == '__main__':
+    os.umask(0o077)
+    asyncio.run(main())
