+@pytest.mark.asyncio
+async def test_cleanup_refuses_foreign_replacement_and_preserves_receipt(tmp_path):
+    owner, provider = ready_owner(tmp_path)
+    try:
+        await owner.stage('slot-1')
+        request = dict(call(), media={'audio':True,'video':True})
+        accepted = await owner.prepare(request)
+        state = provider.load()
+        original = dict(state['rooms'][accepted['session_ref']])
+        state['rooms'][accepted['session_ref']]['sid'] = 'FOREIGN'
+        provider.save(state)
+        await owner.lifecycle(request, dict(event_id='end',transition='ended'), {})
+        await owner.tick()
+        assert provider.load()['deletes'] == 0 and owner.service.journal.receipts
+        assert (await owner.recover(request, {}))['cleanup'] == 'pending'
+        state['rooms'][accepted['session_ref']] = original
+        provider.save(state)
+        await owner.tick()
+        assert not provider.load()['rooms']
+    finally:
+        await dispose(owner)
