+"""Explicit application staging/cancellation. Not called by the npm connector."""
+import argparse
+import json
+import socket
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--socket', required=True)
+    parser.add_argument('method', choices=['stage', 'cancel_slot', 'status'])
+    parser.add_argument('slot_id', nargs='?')
+    args = parser.parse_args()
+    with socket.socket(socket.AF_UNIX) as client:
+        client.settimeout(50)
+        client.connect(args.socket)
+        client.sendall((json.dumps({'method': args.method, 'args': {} if args.method == 'status' else {'slot_id': args.slot_id}})+'\n').encode())
+        result = json.loads(client.makefile().readline(32769))
+        if not result.get('ok'):
+            raise SystemExit('application_control_failed')
+        print(json.dumps(result['result']))
+
+
+if __name__ == '__main__':
+    main()
