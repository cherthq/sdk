+def call(operation='op', budget=4000):
+    now = int(time.time()*1000)
+    return dict(operation_id=operation, project_id='project', line_id='line', call_id='call',
+                request_id='request', deadline_at=now+5000, prepare_deadline_at=now+budget,
+                maximum_session_expires_at=now+7200000, media={'audio': True, 'video': False})
+
+
+async def dispose(owner):
+    # Tests cancel only local monitor tasks. No production shutdown path is called.
+    for handle in owner.service.adapter._handles.values():
+        if handle.task:
+            handle.task.cancel()
+            await asyncio.gather(handle.task, return_exceptions=True)
+    owner.close_journals()
+
+
+@pytest.mark.asyncio
+async def test_production_profile_declines_without_warming_or_http(tmp_path):
