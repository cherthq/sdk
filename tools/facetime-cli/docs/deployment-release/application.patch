+        assert ('chert_reference_agent.http' in sys.modules) == http_before
+        assert owner.service._watcher is None and owner.service.manual.watcher is None
+        assert provider.load()['creates'] == provider.load()['deletes'] == 0
+    finally:
+        await dispose(owner)
