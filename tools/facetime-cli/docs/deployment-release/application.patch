+import { connect } from 'node:net';
+import type { ByorHandler, ApplicationCall } from 'chert-local-transport-proof/byor';
+
+// Private Unix socket owned by the separately supervised Python session owner.
+// Importing this module or checking health never launches it or starts an agent.
+function rpc<T>(method: string, args: unknown, timeout = 1500): Promise<T> {
+  const path = process.env.TALKING_HEAD_CALLBACK_SOCKET;
+  if (!path?.startsWith('/')) return Promise.reject(new Error('application_socket_required'));
+  return new Promise((resolve, reject) => {
+    const socket = connect(path); let buffer = ''; let done = false;
+    const finish = (error?: Error, result?: T) => {
+      if (done) return; done = true; clearTimeout(timer); socket.destroy();
+      if (error) reject(error); else resolve(result as T);
+    };
+    const timer = setTimeout(() => finish(new Error('application_rpc_timeout')), timeout);
+    socket.on('error', () => finish(new Error('application_rpc_unavailable')));
+    socket.on('end', () => finish(new Error('application_rpc_closed')));
+    socket.on('connect', () => socket.write(JSON.stringify({ method, args }) + '\n'));
+    socket.on('data', data => {
+      buffer += data.toString('utf8');
+      if (Buffer.byteLength(buffer) > 32768) return finish(new Error('application_rpc_oversize'));
+      if (!buffer.includes('\n')) return;
+      try {
+        const response = JSON.parse(buffer.slice(0, buffer.indexOf('\n')));
+        if (response.ok !== true) return finish(new Error('application_rpc_failed'));
+        finish(undefined, response.result as T);
+      } catch { finish(new Error('application_rpc_invalid')); }
+    });
+  });
+}
+const cancel = (call: ApplicationCall) => rpc('recover', { call, context: {
+  authoritative_terminal: false, acceptance: 'unknown', cancel_requested: true,
+} }).catch(() => undefined); // Failure leaves durable uncertainty in both owners.
+const handler: ByorHandler = {
+  version: 1,
+  async health() { try { return await rpc('health', {}); } catch { return 'unavailable'; } },
+  async prepare(call, context) {
+    if (context.signal.aborted) { await cancel(call); return { action: 'decline' }; }
+    const abort = () => { void cancel(call); };
+    context.signal.addEventListener('abort', abort, { once: true });
+    try { return await rpc('prepare', { call }, Math.max(1, context.remaining_ms)); }
+    finally { context.signal.removeEventListener('abort', abort); }
+  },
+  lifecycle(call, event, context) { return rpc('lifecycle', { call, event, context }); },
+  recover(call, context) { return rpc('recover', { call, context }); },
+};
+export default handler;
