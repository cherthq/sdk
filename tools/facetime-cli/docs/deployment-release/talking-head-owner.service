# Review template; no unit was installed or started by implementation.
[Unit]
Description=Talking-head durable ready-session owner
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/var/lib/chert-pilot/application-ready-v1
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=chert-pilot
Group=chert-pilot
WorkingDirectory=/opt/talking-head/byor-av-pilot-20260930-r1
EnvironmentFile=/etc/chert-pilot/application.env
Environment=PYTHONPATH=/opt/talking-head/byor-av-pilot-20260930-r1/receiver/src
ExecStart=/opt/talking-head/byor-av-pilot-20260930-r1/venv/bin/python /opt/talking-head/byor-av-pilot-20260930-r1/connector/server.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=50
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RuntimeDirectory=chert-ready-owner
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=restart
ReadWritePaths=/var/lib/chert-pilot/application-ready-v1 /run/chert-ready-owner
# No agent/warming dependency. Init journals separately before first start.

[Install]
WantedBy=multi-user.target
