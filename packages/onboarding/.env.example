# Staging only. Supply secrets through your authorized secret manager; do not commit filled values.
CHERT_DEPLOYMENT_ENV=staging
CHERT_PUBLIC_ORIGIN=https://onboarding.staging.example.invalid
CHERT_WORKER_ORIGIN=https://worker.staging.example.invalid
CHERT_ONBOARDING_DATA_DIR=/var/lib/chert-onboarding-staging
CHERT_ONBOARDING_PORT=4193
# Replace reserved examples with the authorized main line and opted-in staging recipients.
CHERT_MAIN_LINE=+14155550100
CHERT_STAGING_RECIPIENTS=+14155550123
CHERT_FACETIME_ENABLED=false
# Stable base64url encoding of 32 random bytes; keep backups and key separately protected.
CHERT_ONBOARDING_KEY=
# Independent secret injected only by the HTTPS proxy; strip client-supplied proxy headers.
CHERT_PROXY_SECRET=
# Different independent random secrets, at least 32 bytes each; configure the worker to match.
CHERT_WORKER_INBOUND_SECRET=
CHERT_WORKER_OUTBOUND_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SHARED_PRICE_ID=
STRIPE_DEDICATED_PRICE_ID=
